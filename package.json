{
  "name": "pk-task",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "pnpm --filter @pk-task/watchlists dev",
    "build": "pnpm --filter @pk-task/watchlists build",
    "lint": "pnpm --filter @pk-task/watchlists lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @pk-task/db db:generate",
    "db:migrate": "pnpm --filter @pk-task/db db:migrate"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "latest",
    "eslint": "^9.17.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.18.2"
  }
}
